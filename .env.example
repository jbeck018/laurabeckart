PAYLOAD_SECRET=mygeneratedsecret
COMPANY_NAME="Laura Beck Art"
SITE_NAME="Laura Beck Art"
PAYLOAD_PUBLIC_SERVER_URL=http://localhost:3000
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Used to preview drafts
PREVIEW_SECRET=demo-draft-secret

# Stripe API keys
STRIPE_SECRET_KEY=sk_test_
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_
STRIPE_WEBHOOKS_SIGNING_SECRET=whsec_

# Admin order notifications (HTTP email API — works on Cloudflare Workers).
# If RESEND_API_KEY or ADMIN_EMAIL is unset, notifications are skipped (logged) but
# Fulfillment records are still created in the admin panel.
RESEND_API_KEY=
ADMIN_EMAIL=
EMAIL_FROM=orders@laurabeckart.com

# Instagram Feed block (optional). Long-lived Instagram Graph API token.
# If unset, the Instagram Feed block falls back to manually-curated posts.
# See docs/INSTAGRAM_SETUP.md for how to generate and refresh this token.
INSTAGRAM_ACCESS_TOKEN=
